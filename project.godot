; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OVERPOWER"
config/version="0.0.1"
run/main_scene="uid://dluwynytm3sbd"
config/features=PackedStringArray("4.8", "Forward Plus")
run/low_processor_mode=true
run/low_processor_mode_sleep_usec=40000
boot_splash/image="uid://b7adpvxqfcfjj"
config/icon="uid://dnxtb3chlol6x"

[autoload]

CrabbyConsole="*res://addons/crabbyconsole/scenes/autoload/console.tscn"
ECS="*res://addons/gecs/ecs/ecs.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/anthonyec.camera_preview/plugin.cfg", "res://addons/at-icons/plugin.cfg", "res://addons/crabbyconsole/plugin.cfg", "res://addons/gecs/plugin.cfg")

[gecs]

settings/debug_mode=true

[gui]

common/auto_focus_strategy=1
theme/custom_font="uid://2bgwngoiiaau"

